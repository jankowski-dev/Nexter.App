{
  "name": "nexter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @nexter/config build && pnpm --filter @nexter/contracts build && pnpm --filter @nexter/db build && pnpm --filter @nexter/ui build",
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:e2e": "pnpm --filter @nexter/e2e test:e2e",
    "db:generate": "pnpm --filter @nexter/config build && pnpm --filter @nexter/db db:generate",
    "db:migrate": "pnpm --filter @nexter/config build && pnpm --filter @nexter/db db:migrate",
    "db:migrate:prod": "node packages/db/dist/migrate.js",
    "smoke:static": "node scripts/smoke-static.mjs",
    "smoke:worker": "node --check apps/worker/dist/main.js",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down",
    "restore:drill": "pnpm build:packages && pnpm --filter @nexter/db restore:drill",
    "backup": "pnpm build:packages && pnpm --filter @nexter/db backup",
    "backup:selftest": "pnpm --filter @nexter/db backup:selftest",
    "db:provision-app": "pnpm --filter @nexter/db db:provision-app",
    "swap:live-check": "node scripts/swap-live-check.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ],
    "overrides": {
      "fastify": "5.12.8",
      "glob": "14.0.2",
      "js-yaml": "5.4.1",
      "minimatch": "11.0.1",
      "zod@3.22.4": "4.6.7",
      "zod@<4.6.6": "4.6.7"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
