{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "Dockerfile",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.base.json",
      "railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/worker/dist/main.js",
    "restartPolicyType": "ON_FAILURE"
  }
}
