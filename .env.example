NODE_ENV=development
PORT=3000
DATABASE_URL=
LOG_LEVEL=debug
SENTRY_DSN=
APP_URL=http://localhost:5173
SETUP_TOKEN=
AUTH_ENCRYPTION_KEY=
SESSION_TTL_DAYS=30
TOTP_ISSUER=Nexter
WEB_DIST_PATH=
TRUST_PROXY=false
ENABLE_DOCS=true

# Phase 8 swap execution. Leave disabled until configured and reviewed.
SWAP_ENABLED=false
SWAP_EXECUTION_ENABLED=false
# Ethereum execution stays off until its own live acceptance.
SWAP_ETHEREUM_EXECUTION_ENABLED=false
SWAP_KILL_SWITCH=false
SWAP_QUOTE_TTL_SECONDS=15
SWAP_DEFAULT_SLIPPAGE_BPS=50
SWAP_MAX_SLIPPAGE_BPS=200
SWAP_MAX_PRICE_IMPACT_BPS=200
SWAP_BUILD_DEADLINE_SECONDS=300
SWAP_STEP_UP_THRESHOLD_USD=500
SWAP_MAX_GAS_USD=5
SWAP_CONFIRMATIONS=15
# Optional per-chain overrides. BSC falls back to SWAP_CONFIRMATIONS.
SWAP_BSC_CONFIRMATIONS=
SWAP_ETHEREUM_CONFIRMATIONS=12
SWAP_TRACK_INTERVAL_SECONDS=15
SWAP_DROP_TIMEOUT_SECONDS=1800
SWAP_REPLACEMENT_LOOKBACK_BLOCKS=240
# Comma-separated 0x addresses. Empty disables builds.
SWAP_WALLET_ALLOWLIST=
# Legacy BSC-only router/executor lists (kept for backward compatibility).
SWAP_ROUTER_ALLOWLIST=
SWAP_EXECUTOR_ALLOWLIST=
# Per-chain allowlists. Ethereum never inherits the legacy BSC lists.
# Empty uses the chain-specific Kyber MetaAggregationRouterV2.
SWAP_BSC_ROUTER_ALLOWLIST=
SWAP_ETHEREUM_ROUTER_ALLOWLIST=
# Empty uses the chain-specific AggregationExecutorProxy.
SWAP_BSC_EXECUTOR_ALLOWLIST=
SWAP_ETHEREUM_EXECUTOR_ALLOWLIST=
# Required before build is enabled. Comma-separated 4-byte selectors:
# 0xe21fd0e9 = swap, 0x59e50fed = swapGeneric.
SWAP_SELECTOR_ALLOWLIST=
# Phase 10 watch-only reconciliation/indexer. Enable after review.
RECONCILIATION_ENABLED=false
RECONCILIATION_INDEX_INTERVAL_SECONDS=60
RECONCILIATION_LOOKBACK_BLOCKS=100
RECONCILIATION_MAX_BLOCKS_PER_TICK=50
RECONCILIATION_STALE_RUN_SECONDS=3600
# Gateway is preferred when an API key is set; otherwise the public aggregator is used.
KYBERSWAP_BASE_URL=
KYBERSWAP_API_KEY=
KYBERSWAP_CLIENT_ID=nexter
WALLETCONNECT_PROJECT_ID=
# Required for build/simulation; quotes work without it.
BSC_RPC_URL=
# Prefer a private/MEV-protected Ethereum RPC for reads/simulation.
ETHEREUM_RPC_URL=
